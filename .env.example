# 复制本文件为 .env，并填入你的 DashScope(阿里云百炼) API Key
# 部署到其他电脑时，只需新建 .env 填这一项即可，其余默认已对齐本项目
OPENAI_API_KEY=

# 视觉检测模型（识别衣物与部位）
OPENAI_VISION_MODEL=qwen3.7-plus-2026-05-26
# 图像生成模型（上身图 / 抠图）
OPENAI_IMAGE_MODEL=qwen-image-2.0-pro-2026-06-22
# 上身图专用模型（留空则复用图像生成模型）
OPENAI_GARMENT_MODEL=qwen-image-2.0-pro-2026-06-22
OPENAI_IMAGE_QUALITY=high

# AI 服务商：qwen
WARDROBE_AI_PROVIDER=qwen
# Qwen 视觉兼容端点
OPENAI_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Qwen 图像生成端点
QWEN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com

# 人体参考图（本人照，用于上身图合成）
WARDROBE_MODEL_REFERENCE=data/model-reference.png
