OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high

# Add a PNG at data/model-reference.png or point to another local file.
WARDROBE_MODEL_REFERENCE=data/model-reference.png

# ---------------------------------------------------------------------------
# AI provider selection: openai (default) or qwen
# ---------------------------------------------------------------------------
# WARDROBE_AI_PROVIDER=openai

# When WARDROBE_AI_PROVIDER=qwen, the key below is your DashScope (Aliyun
# Model Studio) API key. Vision uses the OpenAI-compatible Chat Completions
# endpoint and image generation/editing uses the DashScope wanx async API.
# OPENAI_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com
# OPENAI_VISION_MODEL=qwen3-vl-plus
# OPENAI_IMAGE_MODEL=wan2.7-image
